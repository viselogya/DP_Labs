<?xml version="1.0"?>
<!--
  Лабораторная 1.4. Манипулятор из лабораторной 1.2 (угловая система координат,
  5 степеней свободы), подготовленный для симулятора Gazebo:
    - звено world и неподвижное крепление основания к нему;
    - <gazebo reference="..."> для звеньев: материалы, отключение гравитации;
    - <transmission> для каждого управляемого шарнира (arm.transmission.xacro);
    - плагин gazebo_ros_control (arm.gazebo.xacro).

  Кинематика и размеры совпадают с lab1_2_manipulator/urdf/manipulator.urdf.
-->
<robot name="arm" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="PI" value="3.14159265"/>
  <xacro:property name="mesh_gripper" value="package://lab1_4_arm_description/meshes/gripper.stl"/>

  <xacro:include filename="$(find lab1_4_arm_description)/urdf/arm.transmission.xacro"/>
  <xacro:include filename="$(find lab1_4_arm_description)/urdf/arm.gazebo.xacro"/>

  <!-- ================= Материалы (для Rviz) ================= -->
  <material name="grey">   <color rgba="0.45 0.45 0.45 1.0"/> </material>
  <material name="orange"> <color rgba="1.0 0.55 0.0 1.0"/>   </material>
  <material name="blue">   <color rgba="0.1 0.3 0.8 1.0"/>    </material>
  <material name="black">  <color rgba="0.1 0.1 0.1 1.0"/>    </material>
  <material name="silver"> <color rgba="0.8 0.8 0.85 1.0"/>   </material>

  <!-- ================= Крепление к миру ================= -->
  <link name="world"/>
  <joint name="fixed_base" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <!-- ================= Основание ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry> <box size="0.3 0.3 0.05"/> </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry> <box size="0.3 0.3 0.05"/> </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.0385" ixy="0" ixz="0" iyy="0.0385" iyz="0" izz="0.075"/>
    </inertial>
  </link>

  <!-- ================= Звено 1: колонна ================= -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-PI}" upper="${PI}" effort="100" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry> <cylinder radius="0.04" length="0.35"/> </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry> <cylinder radius="0.04" length="0.35"/> </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0106" ixy="0" ixz="0" iyy="0.0106" iyz="0" izz="0.0008"/>
    </inertial>
  </link>

  <!-- ================= Звено 2: плечо ================= -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="${-PI/2}" upper="${PI/2}" effort="100" velocity="1.0"/>
    <dynamics damping="0.5" friction="0.0"/>
  </joint>

  <link name="link2">
    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry> <cylinder radius="0.05" length="0.1"/> </geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0.175 0 0" rpy="0 0 0"/>
      <geometry> <box size="0.35 0.05 0.05"/> </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.175 0 0" rpy="0 0 0"/>
      <geometry> <box size="0.35 0.05 0.05"/> </geometry>
    </collision>
    <inertial>
      <origin xyz="0.175 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.00025" ixy="0" ixz="0" iyy="0.0063" iyz="0" izz="0.0063"/>
    </inertial>
  </link>

  <!-- ================= Звено 3: предплечье ================= -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.35 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="100" velocity="1.0"/>
    <dynamics damping="0.2" friction="0.0"/>
  </joint>

  <link name="link3">
    <visual>
      <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      <geometry> <cylinder radius="0.04" length="0.08"/> </geometry>
      <material name="black"/>
    </visual>
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry> <box size="0.3 0.04 0.04"/> </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry> <box size="0.3 0.04 0.04"/> </geometry>
    </collision>
    <inertial>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0031" iyz="0" izz="0.0031"/>
    </inertial>
  </link>

  <!-- ================= Запястье: вращение вокруг оси x ================= -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="wrist_link"/>
    <origin xyz="0.3 0 0" rpy="0 ${PI/2} 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="${-PI/2}" upper="${PI/2}" effort="20" velocity="1.5"/>
    <dynamics damping="0.01" friction="0.0"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry> <cylinder radius="0.025" length="0.04"/> </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry> <cylinder radius="0.025" length="0.04"/> </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/>
    </inertial>
  </link>

  <!-- ================= Схват: вращение вокруг оси z ================= -->
  <joint name="joint5" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-PI}" upper="${PI}" effort="20" velocity="1.5"/>
    <dynamics damping="0.005" friction="0.0"/>
  </joint>

  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry> <mesh filename="${mesh_gripper}"/> </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry> <box size="0.04 0.08 0.1"/> </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0002"/>
    </inertial>
  </link>

  <!-- ================= Приводы и плагины ================= -->
  <xacro:arm_transmission joint="joint1"/>
  <xacro:arm_transmission joint="joint2"/>
  <xacro:arm_transmission joint="joint3"/>
  <xacro:arm_transmission joint="joint4"/>
  <xacro:arm_transmission joint="joint5"/>

  <xacro:arm_gazebo/>

</robot>
