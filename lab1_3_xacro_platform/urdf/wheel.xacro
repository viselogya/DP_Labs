<?xml version="1.0"?>
<!-- Лабораторная 1.3. Колесо - повторяющийся элемент платформы (4 шт.).
     fb = 1 / -1  - переднее / заднее колесо
     lr = 1 / -1  - левое / правое колесо
     angle        - начальный угол поворота колеса вокруг своей оси, рад
     Спица (белый брусок) нужна, чтобы вращение колеса было видно в Rviz. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="wheel" params="prefix fb lr color angle:=0">
    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel"/>
      <origin xyz="${fb*wheel_x} ${lr*wheel_y} ${wheel_z}" rpy="0 ${angle} 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <link name="${prefix}_wheel">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry> <cylinder radius="${wheel_r}" length="${wheel_t}"/> </geometry>
        <material name="${color}"/>
      </visual>
      <!-- спица на внешней стороне колеса -->
      <visual>
        <origin xyz="0 ${lr*(wheel_t/2 + 0.002)} 0" rpy="0 0 0"/>
        <geometry> <box size="${1.6*wheel_r} 0.004 0.02"/> </geometry>
        <material name="white"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
        <geometry> <cylinder radius="${wheel_r}" length="${wheel_t}"/> </geometry>
      </collision>
      <xacro:cylinder_inertial m="${wheel_m}" r="${wheel_r}" h="${wheel_t}">
        <origin xyz="0 0 0" rpy="${PI/2} 0 0"/>
      </xacro:cylinder_inertial>
    </link>
  </xacro:macro>

</robot>
