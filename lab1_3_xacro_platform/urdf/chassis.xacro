<?xml version="1.0"?>
<!-- Лабораторная 1.3. Корпус платформы и надстройка.
     Демонстрирует: макрос с параметрами, условный оператор xacro:if. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="chassis" params="body_color cabin_color with_cabin:=true">
    <!-- проекция центра корпуса на землю: колёса стоят на плоскости z = 0 -->
    <link name="base_footprint"/>
    <joint name="base_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 ${body_z}" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
      <visual>
        <geometry> <box size="${body_l} ${body_w} ${body_h}"/> </geometry>
        <material name="${body_color}"/>
      </visual>
      <collision>
        <geometry> <box size="${body_l} ${body_w} ${body_h}"/> </geometry>
      </collision>
      <xacro:box_inertial m="${body_m}" x="${body_l}" y="${body_w}" z="${body_h}">
        <origin xyz="0 0 0" rpy="0 0 0"/>
      </xacro:box_inertial>
    </link>

    <!-- надстройка добавляется только при with_cabin = true -->
    <xacro:if value="${with_cabin}">
      <joint name="cabin_joint" type="fixed">
        <parent link="base_link"/>
        <child link="cabin_link"/>
        <origin xyz="${body_l/2 - cabin_l/2 - 0.02} 0 ${body_h/2 + cabin_h/2}" rpy="0 0 0"/>
      </joint>
      <link name="cabin_link">
        <visual>
          <geometry> <box size="${cabin_l} ${cabin_w} ${cabin_h}"/> </geometry>
          <material name="${cabin_color}"/>
        </visual>
        <collision>
          <geometry> <box size="${cabin_l} ${cabin_w} ${cabin_h}"/> </geometry>
        </collision>
        <xacro:box_inertial m="0.5" x="${cabin_l}" y="${cabin_w}" z="${cabin_h}">
          <origin xyz="0 0 0" rpy="0 0 0"/>
        </xacro:box_inertial>
      </link>
    </xacro:if>
  </xacro:macro>

</robot>
