<?xml version="1.0"?>
<!--
  Лабораторная работа 1.2. Робот-манипулятор с 5 степенями свободы.
  Вариант: г) угловая (антропоморфная) система координат.

  Кинематическая схема:
    joint1 - вращение колонны вокруг вертикальной оси z     (основное звено 1)
    joint2 - вращение «плеча» вокруг горизонтальной оси y    (основное звено 2)
    joint3 - вращение «локтя» вокруг горизонтальной оси y    (основное звено 3)
    joint4 - вращение основания схвата вокруг оси x          (схват, 1-я доп. степень свободы)
    joint5 - вращение основания схвата вокруг оси z          (схват, 2-я доп. степень свободы)

  Три основных звена построены из геометрических примитивов,
  схват - готовая 3D-модель meshes/gripper.stl (начало координат в центре основания,
  губки направлены вдоль оси z).
  Красная сфера-мишень закреплена неподвижно относительно основания (target_joint).
-->
<robot name="manipulator">

  <!-- ================= Материалы ================= -->
  <material name="grey">   <color rgba="0.45 0.45 0.45 1.0"/> </material>
  <material name="orange"> <color rgba="1.0 0.55 0.0 1.0"/>   </material>
  <material name="blue">   <color rgba="0.1 0.3 0.8 1.0"/>    </material>
  <material name="black">  <color rgba="0.1 0.1 0.1 1.0"/>    </material>
  <material name="silver"> <color rgba="0.8 0.8 0.85 1.0"/>   </material>
  <material name="red">    <color rgba="1.0 0.0 0.0 1.0"/>    </material>

  <!-- ================= Основание ================= -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry> <box size="0.3 0.3 0.05"/> </geometry>
      <material name="grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry> <box size="0.3 0.3 0.05"/> </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <mass value="5.0"/>
      <inertia ixx="0.0385" ixy="0" ixz="0" iyy="0.0385" iyz="0" izz="0.075"/>
    </inertial>
  </link>

  <!-- ================= Звено 1: колонна ================= -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="100" velocity="1.0"/>
  </joint>

  <link name="link1">
    <visual>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry> <cylinder radius="0.04" length="0.35"/> </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <geometry> <cylinder radius="0.04" length="0.35"/> </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.175" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia ixx="0.0106" ixy="0" ixz="0" iyy="0.0106" iyz="0" izz="0.0008"/>
    </inertial>
  </link>

  <!-- ================= Звено 2: плечо ================= -->
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.57" upper="1.57" effort="100" velocity="1.0"/>
  </joint>

  <link name="link2">
    <!-- шарнир плеча -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry> <cylinder radius="0.05" length="0.1"/> </geometry>
      <material name="black"/>
    </visual>
    <!-- балка плеча -->
    <visual>
      <origin xyz="0.175 0 0" rpy="0 0 0"/>
      <geometry> <box size="0.35 0.05 0.05"/> </geometry>
      <material name="blue"/>
    </visual>
    <collision>
      <origin xyz="0.175 0 0" rpy="0 0 0"/>
      <geometry> <box size="0.35 0.05 0.05"/> </geometry>
    </collision>
    <inertial>
      <origin xyz="0.175 0 0" rpy="0 0 0"/>
      <mass value="0.6"/>
      <inertia ixx="0.00025" ixy="0" ixz="0" iyy="0.0063" iyz="0" izz="0.0063"/>
    </inertial>
  </link>

  <!-- ================= Звено 3: предплечье ================= -->
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.35 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-2.5" upper="2.5" effort="100" velocity="1.0"/>
  </joint>

  <link name="link3">
    <!-- шарнир локтя -->
    <visual>
      <origin xyz="0 0 0" rpy="1.5708 0 0"/>
      <geometry> <cylinder radius="0.04" length="0.08"/> </geometry>
      <material name="black"/>
    </visual>
    <!-- балка предплечья -->
    <visual>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry> <box size="0.3 0.04 0.04"/> </geometry>
      <material name="orange"/>
    </visual>
    <collision>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <geometry> <box size="0.3 0.04 0.04"/> </geometry>
    </collision>
    <inertial>
      <origin xyz="0.15 0 0" rpy="0 0 0"/>
      <mass value="0.4"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0031" iyz="0" izz="0.0031"/>
    </inertial>
  </link>

  <!-- ================= Запястье: вращение вокруг оси x ================= -->
  <!-- Поворот rpy="0 1.5708 0" направляет ось z запястья вдоль предплечья -->
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="wrist_link"/>
    <origin xyz="0.3 0 0" rpy="0 1.5708 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.57" upper="1.57" effort="20" velocity="1.5"/>
  </joint>

  <link name="wrist_link">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry> <cylinder radius="0.025" length="0.04"/> </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry> <cylinder radius="0.025" length="0.04"/> </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <mass value="0.1"/>
      <inertia ixx="0.00003" ixy="0" ixz="0" iyy="0.00003" iyz="0" izz="0.00003"/>
    </inertial>
  </link>

  <!-- ================= Схват: вращение вокруг оси z ================= -->
  <joint name="joint5" type="revolute">
    <parent link="wrist_link"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-3.14" upper="3.14" effort="20" velocity="1.5"/>
  </joint>

  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry> <mesh filename="package://lab1_2_manipulator/meshes/gripper.stl"/> </geometry>
      <material name="silver"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry> <box size="0.04 0.08 0.1"/> </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0.04" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia ixx="0.0003" ixy="0" ixz="0" iyy="0.0002" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- ================= Красная сфера-мишень ================= -->
  <!-- Координаты рассчитаны так, чтобы в конечном положении
       (config/joints.yaml -> goal) сфера находилась между губками схвата -->
  <joint name="target_joint" type="fixed">
    <parent link="base_link"/>
    <child link="target_sphere"/>
    <origin xyz="0.4052 0.2853 0.1109" rpy="0 0 0"/>
  </joint>

  <link name="target_sphere">
    <visual>
      <geometry> <sphere radius="0.02"/> </geometry>
      <material name="red"/>
    </visual>
  </link>

</robot>
