<?xml version="1.0"?>
<!-- Лабораторная 1.4. Свойства звеньев для Gazebo и плагин gazebo_ros_control.

     Гравитация для подвижных звеньев отключена (turnGravityOff): манипулятор
     демонстрирует кинематику и цикловое управление, а без компенсации силы тяжести
     ПИД-регуляторы с умеренными коэффициентами давали бы статическую ошибку. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="arm_link_gazebo" params="link material gravity_off:=true">
    <gazebo reference="${link}">
      <material>${material}</material>
      <mu1>0.8</mu1>
      <mu2>0.8</mu2>
      <xacro:if value="${gravity_off}">
        <turnGravityOff>true</turnGravityOff>
      </xacro:if>
    </gazebo>
  </xacro:macro>

  <xacro:macro name="arm_gazebo">
    <xacro:arm_link_gazebo link="base_link"    material="Gazebo/Grey" gravity_off="false"/>
    <xacro:arm_link_gazebo link="link1"        material="Gazebo/Orange"/>
    <xacro:arm_link_gazebo link="link2"        material="Gazebo/Blue"/>
    <xacro:arm_link_gazebo link="link3"        material="Gazebo/Orange"/>
    <xacro:arm_link_gazebo link="wrist_link"   material="Gazebo/White"/>
    <xacro:arm_link_gazebo link="gripper_link" material="Gazebo/White"/>

    <!-- программируемый контроллер: связывает трансмиссии с контроллерами ros_control -->
    <gazebo>
      <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
        <robotNamespace>/arm</robotNamespace>
        <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
      </plugin>
    </gazebo>
  </xacro:macro>

</robot>
