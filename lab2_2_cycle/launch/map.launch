<?xml version="1.0"?>
<launch>
  <arg name="rviz" default="true"/>
  <node name="map_server" pkg="map_server" type="map_server"
        args="'$(find lab2_2_cycle)/maps/warehouse.yaml'"/>
  <node if="$(arg rviz)" name="warehouse_rviz" pkg="rviz" type="rviz"
        args="-d '$(find lab2_2_cycle)/config/warehouse.rviz'"/>
</launch>
