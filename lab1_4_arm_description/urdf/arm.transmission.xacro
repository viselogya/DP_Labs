<?xml version="1.0"?>
<!-- Лабораторная 1.4. Описание электропривода шарнира: простая трансмиссия
     с управлением по моменту (EffortJointInterface). Тип интерфейса должен совпадать
     с типом контроллеров в lab1_4_arm_control/config/arm_control.yaml
     (effort_controllers/JointPositionController). -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="arm_transmission" params="joint reduction:=1">
    <transmission name="${joint}_trans">
      <type>transmission_interface/SimpleTransmission</type>
      <joint name="${joint}">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      </joint>
      <actuator name="${joint}_motor">
        <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
        <mechanicalReduction>${reduction}</mechanicalReduction>
      </actuator>
    </transmission>
  </xacro:macro>

</robot>
